NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://healthuser:healthpassword@localhost:5432/healthtracking?schema=public"
# Only needed against a pooled host (e.g. Neon's "-pooler" endpoint) — same database,
# direct (non-pooled) connection string. Used solely for running migrations.
DIRECT_URL="postgresql://healthuser:healthpassword@localhost:5432/healthtracking?schema=public"

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 32-byte key, hex-encoded (64 hex characters) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
