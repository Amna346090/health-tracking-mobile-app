generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  STAFF
  ADMIN
}

enum FeelingStatus {
  GREAT
  GOOD
  OKAY
  POOR
  TERRIBLE
}

enum DoseStatus {
  TAKEN
  MISSED
  SKIPPED
}

enum MedicationForm {
  TABLET
  CAPSULE
  LIQUID
  INJECTION
  TOPICAL
  OTHER
}

enum FoodInstruction {
  WITH_FOOD
  WITHOUT_FOOD
  EITHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ReminderChannel {
  PUSH
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum TestRequestStatus {
  PENDING
  SUBMITTED
  CANCELLED
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(PATIENT)
  firstName    String
  lastName     String
  pushToken    String?
  notifPush    Boolean  @default(true)
  notifEmail   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile        PatientProfile?
  refreshTokens         RefreshToken[]
  medicationLogs        MedicationLog[]
  healthLogsCreated     HealthLog[]            @relation("HealthLogCreatedBy")
  photosUploaded        Photo[]                @relation("PhotoUploadedBy")
  appointmentsCreated   Appointment[]          @relation("AppointmentCreatedBy")
  messagesSent          Message[]              @relation("MessageSentBy")
  assignmentsPrescribed MedicationAssignment[] @relation("AssignmentPrescribedBy")
  documentsUploaded     Document[]             @relation("DocumentUploadedBy")
  testRequestsCreated   TestRequest[]          @relation("TestRequestedBy")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Patient ──────────────────────────────────────────────────────────────────

model PatientProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth DateTime @db.Date
  gender      Gender?
  healthIssue String?
  avatarUrl   String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  medicationAssignments   MedicationAssignment[]
  healthLogs              HealthLog[]
  photos                  Photo[]
  reminderLogs            ReminderLog[]
  appointments            Appointment[]
  appointmentReminderLogs AppointmentReminderLog[]
  messages                Message[]
  documents               Document[]
  testRequests            TestRequest[]
  testRequestReminderLogs TestRequestReminderLog[]
}

// ─── Medication ───────────────────────────────────────────────────────────────

model Medication {
  id               Int              @id @default(autoincrement())
  name             String
  dosage           String
  doseAmount       Float?
  doseUnit         String?
  form             MedicationForm?
  quantityPerDose  Int?
  foodInstruction  FoodInstruction?
  instructions     String?
  prescribingNotes String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  assignments MedicationAssignment[]
}

model MedicationAssignment {
  id             Int            @id @default(autoincrement())
  patientId      Int
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationId   Int
  medication     Medication     @relation(fields: [medicationId], references: [id])
  frequency      String
  timesPerDay    Int?
  timesOfDay     String[]
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  refillsAllowed Int?
  refillsUsed    Int            @default(0)
  prescribedById Int?
  prescribedBy   User?          @relation("AssignmentPrescribedBy", fields: [prescribedById], references: [id])
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  logs         MedicationLog[]
  reminderLogs ReminderLog[]

  @@index([patientId])
  @@index([medicationId])
}

model MedicationLog {
  id           Int                  @id @default(autoincrement())
  assignmentId Int
  assignment   MedicationAssignment @relation(fields: [assignmentId], references: [id])
  userId       Int
  user         User                 @relation(fields: [userId], references: [id])
  status       DoseStatus
  takenAt      DateTime             @default(now())
  notes        String?

  @@index([assignmentId])
  @@index([userId])
}

// ─── Health ───────────────────────────────────────────────────────────────────

model HealthLog {
  id          Int            @id @default(autoincrement())
  patientId   Int
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date        DateTime       @db.Date
  weight      Float?
  height      Float?
  feeling     FeelingStatus?
  notes       String?
  createdById Int
  createdBy   User           @relation("HealthLogCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  photos Photo[]

  @@index([patientId])
}

model Photo {
  id           Int            @id @default(autoincrement())
  patientId    Int
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  healthLogId  Int?
  healthLog    HealthLog?     @relation(fields: [healthLogId], references: [id])
  url          String
  key          String?
  caption      String?
  uploadedById Int
  uploadedBy   User           @relation("PhotoUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime       @default(now())

  @@index([patientId])
}

// ─── Reminders ────────────────────────────────────────────────────────────────

model ReminderLog {
  id           Int                  @id @default(autoincrement())
  patientId    Int
  patient      PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignmentId Int
  assignment   MedicationAssignment @relation(fields: [assignmentId], references: [id])
  scheduledFor DateTime
  channel      ReminderChannel
  status       ReminderStatus       @default(PENDING)
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime             @default(now())

  @@unique([assignmentId, scheduledFor, channel])
  @@index([patientId])
  @@index([assignmentId])
}

// ─── Appointments ─────────────────────────────────────────────────────────────

model Appointment {
  id           Int               @id @default(autoincrement())
  patientId    Int
  patient      PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  reason       String?
  notes        String?
  status       AppointmentStatus @default(SCHEDULED)
  createdById  Int
  createdBy    User              @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  reminderLogs AppointmentReminderLog[]
  documents    Document[]

  @@index([patientId])
  @@index([scheduledFor])
}

model AppointmentReminderLog {
  id            Int             @id @default(autoincrement())
  appointmentId Int
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     Int
  patient       PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  offsetLabel   String
  channel       ReminderChannel
  status        ReminderStatus  @default(PENDING)
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime        @default(now())

  @@unique([appointmentId, offsetLabel, channel])
  @@index([patientId])
  @@index([appointmentId])
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id            Int            @id @default(autoincrement())
  patientId     Int
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId Int?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  fileType      String
  tag           String?
  url           String
  key           String?
  uploadedById  Int
  uploadedBy    User           @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt    DateTime       @default(now())

  testRequestFulfillments TestRequest[]

  @@index([patientId])
  @@index([appointmentId])
}

// ─── Test/Scan Requests ─────────────────────────────────────────────────────────

model TestRequest {
  id            Int               @id @default(autoincrement())
  patientId     Int
  patient       PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name          String
  instructions  String?
  dueDate       DateTime          @db.Date
  status        TestRequestStatus @default(PENDING)
  documentId    Int?
  document      Document?         @relation(fields: [documentId], references: [id])
  requestedById Int
  requestedBy   User              @relation("TestRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  reminderLogs TestRequestReminderLog[]

  @@index([patientId])
  @@index([dueDate])
}

model TestRequestReminderLog {
  id            Int             @id @default(autoincrement())
  testRequestId Int
  testRequest   TestRequest     @relation(fields: [testRequestId], references: [id], onDelete: Cascade)
  patientId     Int
  patient       PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  offsetLabel   String
  channel       ReminderChannel
  status        ReminderStatus  @default(PENDING)
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime        @default(now())

  @@unique([testRequestId, offsetLabel, channel])
  @@index([patientId])
  @@index([testRequestId])
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id        Int            @id @default(autoincrement())
  patientId Int
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User           @relation("MessageSentBy", fields: [senderId], references: [id])
  body      String
  readAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([patientId])
  @@index([senderId])
}
