{
  "expo": {
    "name": "SFLBiotrack",
    "slug": "sflbiotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sflbiotrack",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sflbiotrack.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.sflbiotrack.app"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
