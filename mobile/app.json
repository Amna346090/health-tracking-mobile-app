{
  "expo": {
    "name": "SFLBiotrack",
    "slug": "sflbiotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sflbiotrack",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sflbiotrack.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.sflbiotrack.app"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e90270e0-b00e-488e-8b3e-4a0573ba70bb"
      }
    }
  }
}
